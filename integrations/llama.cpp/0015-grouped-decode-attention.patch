From c9d094fdc91fbe1d1927c70af39af01d72b06b13 Mon Sep 17 00:00:00 2001
From: codewic <codewic@users.noreply.github.com>
Date: Tue, 24 Nov 2026 12:04:51 +0000
Subject: [PATCH 2/2] corsia: grouped decode attention for GQA models

---
 ggml/src/ggml-cpu/ops.cpp | 148 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 148 insertions(+)

diff --git a/ggml/src/ggml-cpu/ops.cpp b/ggml/src/ggml-cpu/ops.cpp
index 00a8140..35c5577 100644
--- a/ggml/src/ggml-cpu/ops.cpp
+++ b/ggml/src/ggml-cpu/ops.cpp
@@ -9426,6 +9426,140 @@ static void ggml_flash_attn_ext_reduce_partials(
     }
 }
 
+// Corsia: grouped decode attention. With grouped-query attention several query heads share one
+// KV head (8 to 1 in Qwen3-30B-A3B), and the per-head loop above reads every K row and converts
+// every V row once per query head: at 6,000 tokens of context that is gigabytes per token. For a
+// single decoded token this walks each KV head once, scores every K row against all the query
+// heads of its group and converts every V row once. Each head gets exactly the same operations
+// in the same order as in the loop above, so the output is identical. CORSIA_GQA_DECODE=0 turns
+// it off.
+static bool corsia_gqa_decode_on() {
+    static const bool on = [] { const char * e = getenv("CORSIA_GQA_DECODE"); return !(e && strcmp(e, "0") == 0); }();
+    return on;
+}
+
+static void ggml_compute_forward_flash_attn_ext_gqa_decode(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * q    = dst->src[0];
+    const ggml_tensor * k    = dst->src[1];
+    const ggml_tensor * v    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+
+    GGML_TENSOR_LOCALS(int64_t, neq, q,   ne)
+    GGML_TENSOR_LOCALS(size_t,  nbq, q,   nb)
+    GGML_TENSOR_LOCALS(int64_t, nek, k,   ne)
+    GGML_TENSOR_LOCALS(size_t,  nbk, k,   nb)
+    GGML_TENSOR_LOCALS(int64_t, nev, v,   ne)
+    GGML_TENSOR_LOCALS(size_t,  nbv, v,   nb)
+    GGML_TENSOR_LOCALS(int64_t, ne,  dst, ne)
+    GGML_TENSOR_LOCALS(size_t,  nb,  dst, nb)
+
+    const int64_t DK = nek0;
+    const int64_t DV = nev0;
+    const int64_t R  = neq2/nek2; // query heads per KV head
+
+    float scale = 1.0f, max_bias = 0.0f, logit_softcap = 0.0f;
+    memcpy(&scale,         (float *) dst->op_params + 0, sizeof(float));
+    memcpy(&max_bias,      (float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (float *) dst->op_params + 2, sizeof(float));
+    if (logit_softcap != 0) {
+        scale /= logit_softcap;
+    }
+    const uint32_t n_head      = neq2;
+    const uint32_t n_head_log2 = 1u << (uint32_t) floor(log2(n_head));
+    const float m0 = powf(2.0f, -(max_bias       ) / n_head_log2);
+    const float m1 = powf(2.0f, -(max_bias / 2.0f) / n_head_log2);
+
+    ggml_type         const k_vec_dot_type = ggml_get_type_traits_cpu(k->type)->vec_dot_type;
+    ggml_from_float_t const q_to_vec_dot   = ggml_get_type_traits_cpu(k_vec_dot_type)->from_float;
+    ggml_vec_dot_t    const kq_vec_dot     = ggml_get_type_traits_cpu(k->type)->vec_dot;
+    ggml_to_float_t   const v_to_float     = ggml_get_type_traits(v->type)->to_float;
+    const size_t q_row = ggml_row_size(k_vec_dot_type, DK);
+
+    // per thread: R quantized queries, R accumulators, one converted V row
+    static thread_local std::vector<char>  qbuf;
+    static thread_local std::vector<float> fbuf;
+    qbuf.resize((size_t) R * q_row + 64);
+    fbuf.resize((size_t) R * (DV + 2) + DV + 16);
+    float * VKQ = fbuf.data();               // [R][DV]
+    float * M   = VKQ + R*DV;                // [R]
+    float * S   = M + R;                     // [R]
+    float * V32 = S + R;                     // [DV]
+    std::vector<float> slope(R), sc(R);
+    std::vector<const ggml_fp16_t *> mp(R);
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+    const int64_t iq1 = 0, iq3 = 0;
+
+    for (int64_t g = ith; g < nek2; g += nth) {
+        for (int64_t r = 0; r < R; ++r) {
+            const int64_t iq2 = g*R + r;
+            const uint32_t h = iq2;
+            slope[r] = (max_bias > 0.0f) ? h < n_head_log2 ? powf(m0, h + 1) : powf(m1, 2*(h - n_head_log2) + 1) : 1.0f;
+            mp[r] = mask ? (const ggml_fp16_t *)((const char *) mask->data + iq1*mask->nb[1] + (iq2%mask->ne[2])*mask->nb[2] + (iq3%mask->ne[3])*mask->nb[3]) : nullptr;
+            const float * pq = (const float *) ((const char *) q->data + (iq1*nbq1 + iq2*nbq2 + iq3*nbq3));
+            q_to_vec_dot(pq, qbuf.data() + r*q_row, DK);
+            memset(VKQ + r*DV, 0, DV*sizeof(float));
+            M[r] = -INFINITY;
+            S[r] = 0.0f;
+        }
+        const int64_t ik2 = g, iv2 = g; // rk2 == rv2 == R
+        for (int64_t ic = 0; ic < nek1; ++ic) {
+            const char * k_data = (const char *) k->data + (ic*nbk1 + ik2*nbk2);
+            bool any = false;
+            for (int64_t r = 0; r < R; ++r) {
+                const float mv = mp[r] ? slope[r]*GGML_CPU_FP16_TO_FP32(mp[r][ic]) : 0.0f;
+                if (mv == -INFINITY) {
+                    sc[r] = -INFINITY;
+                    continue;
+                }
+                float s;
+                kq_vec_dot(DK, &s, 0, k_data, 0, qbuf.data() + r*q_row, 0, 1);
+                s = s*scale;
+                if (logit_softcap != 0.0f) {
+                    s = logit_softcap*tanhf(s);
+                }
+                sc[r] = s + mv;
+                any = true;
+            }
+            if (!any) {
+                continue;
+            }
+            const char * v_data = (const char *) v->data + (ic*nbv1 + iv2*nbv2);
+            const float * vrow = (const float *) v_data;
+            if (v_to_float) {
+                v_to_float(v_data, V32, DV);
+                vrow = V32;
+            }
+            for (int64_t r = 0; r < R; ++r) {
+                const float s = sc[r];
+                if (s == -INFINITY) {
+                    continue;
+                }
+                float ms = 1.0f, vs = 1.0f;
+                float * acc = VKQ + r*DV;
+                if (s > M[r]) {
+                    const float Mold = M[r];
+                    M[r] = s;
+                    ms = expf(Mold - s);
+                    ggml_vec_scale_f32(DV, acc, ms);
+                } else {
+                    vs = expf(s - M[r]);
+                }
+                ggml_vec_mad_f32(DV, acc, vrow, vs);
+                S[r] = S[r]*ms + vs;
+            }
+        }
+        for (int64_t r = 0; r < R; ++r) {
+            float * acc = VKQ + r*DV;
+            const float S_inv = S[r] == 0.0f ? 0.0f : 1.0f/S[r];
+            ggml_vec_scale_f32(DV, acc, S_inv);
+            const int64_t i2 = g*R + r;
+            memcpy((char *) dst->data + (iq3*ne2*ne1 + i2 + iq1*ne1)*nb1, acc, nb1);
+        }
+    }
+}
+
 static void ggml_compute_forward_flash_attn_ext_f16(
         const ggml_compute_params * params,
         ggml_tensor * dst) {
@@ -9474,6 +9608,20 @@ static void ggml_compute_forward_flash_attn_ext_f16(
     // When use_ref is set, force the vec-only reference implementation (no tiling, no KV-chunking)
     const bool use_ref = params->use_ref;
 
+    if (!use_ref && corsia_gqa_decode_on()) {
+        const ggml_tensor * gq = dst->src[0];
+        const ggml_tensor * gk = dst->src[1];
+        const ggml_tensor * gv = dst->src[2];
+        if (dst->src[4] == nullptr && dst->src[5] == nullptr && gq->type == GGML_TYPE_F32 &&
+            gq->ne[1] == 1 && gq->ne[3] == 1 && gk->ne[3] == 1 && gv->ne[3] == 1 &&
+            gk->ne[2] == gv->ne[2] && gq->ne[2] > gk->ne[2] && gq->ne[2] % gk->ne[2] == 0 &&
+            gk->ne[2] >= params->nth && gv->type != GGML_TYPE_F16 &&
+            gq->nb[0] == ggml_type_size(gq->type) && gk->nb[0] == ggml_type_size(gk->type) && gv->nb[0] == ggml_type_size(gv->type)) {
+            ggml_compute_forward_flash_attn_ext_gqa_decode(params, dst);
+            return;
+        }
+    }
+
     // with kv_rows the loops run over the mask columns, the split KV path does not support it
     const ggml_tensor * kv_rows = dst->src[5];
     const int64_t n_kv_cols = kv_rows ? kv_rows->ne[0] : nek1;
-- 
2.53.0

