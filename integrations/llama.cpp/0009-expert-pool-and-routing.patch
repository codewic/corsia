@@ -84,6 +102,26 @@ struct corsia_experts {
     std::vector<float> x, h, logits;
     std::vector<int32_t> order;
 
+    // The expert pool (CORSIA_POOL_MIB): experts in engine-owned memory instead of the page cache.
+    std::unique_ptr<corsia_pool> pool;
+
+    // Residency-aware routing (CORSIA_SWAP).
+    bool swap_on = false;
+    float swap_ratio = 0.5f;
+    int swap_max = 2;
+    int swap_depth = 8;
+    int probs_layer = -1;      // layer whose router probabilities are in probs_row
+    std::vector<float> probs_row;
+    std::vector<unsigned char> core;
+    uint64_t swap_layers = 0, swap_experts = 0, miss_layers = 0, stalls_avoided = 0;
+
+    // Confidence-based skipping (CORSIA_SKIP).
+    float skip_below = 0.0f;
+    int skip_min = 4;
+    int drop_layer = -1;
+    std::vector<uint8_t> drop; // per top-k slot, for the layer in drop_layer
+    uint64_t skipped_experts = 0, skip_chances = 0;
+
     // Routing trace (CORSIA_TRACE): one line per generated token, one group per layer.
     FILE * trace = nullptr;
     std::vector<std::vector<int32_t>> trace_tok;
@@ -104,6 +142,15 @@ struct corsia_experts {
             LOG_INF("corsia: %llu expert prefetches, %llu MiB put in memory ahead of use\n",
                 (unsigned long long) requests, (unsigned long long) (bytes >> 20));
         }
+        if (skip_below > 0 && skip_chances) {
+            LOG_INF("corsia: skipped %llu of %llu chosen experts whose weight was under %.3f (%.1f%%)\n",
