@@ -251,6 +298,9 @@ struct corsia_experts {
         ranges.clear();
         for (const tensor & tn : layers[t]) {
             for (int32_t e : guessed[t]) {
+                if (pool && pool->has(t, e)) {
+                    continue; // already in the pool: fetching it again would only crowd the pool out
+                }
                 if (e < tn.n_expert && tn.stride <= UINT32_MAX) {
                     ranges.push_back({ tn.offs + e * tn.stride, (uint32_t) tn.stride, 0 });
