diff --git a/common/corsia-pool.h b/common/corsia-pool.h
new file mode 100644
index 0000000..ff975c0
--- /dev/null
+++ b/common/corsia-pool.h
@@ -0,0 +1,393 @@
+#pragma once
+
+// The expert pool: experts live in memory the engine owns, not in the kernel's page cache.
+//
+// With CORSIA_POOL_MIB set (and CORSIA_SOCKET), a fixed block of shared memory is divided
+// into slots, one slot per (layer, expert) holding that expert's slices of the layer's
+// expert tensors. When a layer's router has chosen, the chosen experts that are not in the
+// pool are read by Corsia straight from its drives into free or least recently used slots,
+// in one request per layer, and ggml's expert matmul is pointed at the slots through the
+// CPU backend's expert pointer table. No page faults, no copies through the mount, no
+// kernel reclaim under a memory cap, and the engine decides exactly which experts stay.
+//
+// A missing expert whose pages are already in the page cache is copied into its slot at
+// memory speed instead of read from the drives.
+//
+// Anything that fails leaves the expert at its usual place in the memory-mapped file, so
+// the pool can only make a run faster, never wrong: the bytes are the same either way.
+//
+// The pool remembers which experts the model uses. At exit it writes a usage profile
+// (CORSIA_POOL_PROFILE, default ~/.cache/corsia/<model>.pool-profile), merged with the
+// runs before it, older runs counting half. At start it reads the profile and loads the
+// most used experts before the first token, so a run starts warm: on a real trace a pool
+// of 2,200 experts went from 84% to 98% of experts found in the first quarter of a run.
+
+#include "../src/corsia-client.h"
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "log.h"
+
+#include <sys/stat.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+struct corsia_pool {
+    struct slice {
+        std::string name; // the weight tensor's name in the model
+        uint64_t offs;    // file offset of expert 0
+        uint64_t stride;  // bytes per expert
+    };
+
+    corsia_client * io = nullptr;
+    uint8_t * base = nullptr;
+    uint64_t slot_bytes = 0;
+    int64_t n_slots = 0;
+    int64_t n_expert = 0;
+    std::vector<std::vector<slice>> layers;                       // per layer: its expert tensors
+    std::vector<std::vector<std::vector<const void *>>> ptrs;     // [layer][tensor][expert] -> pool data or null
+    std::vector<std::vector<uint8_t>> registered;                 // [layer][tensor]
+    std::vector<int32_t> where;      // [layer * n_expert + expert] -> slot, -1 when not pooled
+    std::vector<int32_t> owner;      // [slot] -> layer * n_expert + expert, -1 when free
+    std::vector<uint64_t> last_use;  // [slot]
+    std::vector<double> uses;        // [layer * n_expert + expert], this run plus the profile
+    std::string profile;
+    uint64_t tick = 0;
+    uint64_t hits = 0, loads = 0, loaded_bytes = 0, failures = 0, registered_n = 0;
+    uint64_t copies = 0, copied_bytes = 0;
+    const uint8_t * map = nullptr; // the model file mapped read-only (shares the page cache)
+    size_t map_len = 0;
+    std::vector<unsigned char> core;
+
+    using set_fn = void (*)(const void * data, const void * const * ptrs);
+    set_fn set_ptrs = nullptr;
+
+    ~corsia_pool() {
+        save_profile();
+        if (hits + loads + copies) {
+            LOG_INF("corsia: expert pool: %lld slots of %.1f MiB, %llu of %llu chosen experts already there (%.0f%%), %llu MiB read into it, %llu experts (%llu MiB) copied in from guesses, %llu tensors pointed at it%s\n",
+                (long long) n_slots, slot_bytes / 1048576.0, (unsigned long long) hits, (unsigned long long) (hits + loads + copies),
+                100.0 * hits / (hits + loads + copies), (unsigned long long) (loaded_bytes >> 20),
+                (unsigned long long) copies, (unsigned long long) (copied_bytes >> 20), (unsigned long long) registered_n,
+                failures ? ", some reads failed (those experts used the mapped file)" : "");
+        }
+        if (io) {
+            corsia_close(io); // ggml's tables point into this memory; the process is ending
+        }
+    }
+
+    // Sizes the slots for the largest layer and connects with the pool as the shared arena.
+    bool init(const char * socket, uint64_t pool_bytes, std::vector<std::vector<slice>> in, int64_t experts, const std::string & model_path) {
+        layers = std::move(in);
+        n_expert = experts;
+        for (const auto & l : layers) {
+            uint64_t b = 0;
+            for (const slice & s : l) {
+                b += room(s.stride);
+            }
+            slot_bytes = std::max(slot_bytes, b);
+        }
+        if (slot_bytes == 0) {
+            return false;
+        }
+        n_slots = (int64_t) (pool_bytes / slot_bytes);
+        if (n_slots < n_expert) {
+            LOG_WRN("corsia: an expert pool of %llu MiB holds %lld experts, fewer than one layer's %lld; not using it\n",
+                (unsigned long long) (pool_bytes >> 20), (long long) n_slots, (long long) n_expert);
+            return false;
+        }
+        ggml_backend_reg_t reg = ggml_backend_reg_by_name("CPU");
+        set_ptrs = reg ? (set_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cpu_set_expert_ptrs") : nullptr;
+        if (set_ptrs == nullptr) {
+            LOG_WRN("corsia: this ggml has no expert pointer table; not using the expert pool\n");
+            return false;
+        }
+        char err[256] = {0};
+        io = corsia_connect(socket, (size_t) (n_slots * slot_bytes), err, sizeof(err));
+        if (io == nullptr) {
+            LOG_WRN("corsia: could not share an expert pool with Corsia (%s); not using it\n", err);
+            return false;
+        }
+        base = corsia_arena(io);
+        ptrs.resize(layers.size());
+        registered.resize(layers.size());
+        for (size_t il = 0; il < layers.size(); il++) {
+            ptrs[il].assign(layers[il].size(), std::vector<const void *>(n_expert, nullptr));
+            registered[il].assign(layers[il].size(), 0);
+        }
+        where.assign(layers.size() * n_expert, -1);
+        owner.assign(n_slots, -1);
+        last_use.assign(n_slots, 0);
+        uses.assign(layers.size() * n_expert, 0.0);
+        if (const char * pp = std::getenv("CORSIA_POOL_PROFILE"); pp && *pp) {
+            profile = pp;
+        } else if (const char * home = std::getenv("HOME")) {
+            const size_t slash = model_path.find_last_of('/');
+            profile = std::string(home) + "/.cache/corsia/" + model_path.substr(slash == std::string::npos ? 0 : slash + 1) + ".pool-profile";
+        }
+        warm();
+        return true;
+    }
+
+    // Reads the profile (one "layer expert uses" line each) and loads the most used experts.
+    void warm() {
+        std::ifstream in(profile);
+        if (!in) {
+            return;
+        }
+        std::string line;
+        std::vector<std::pair<double, int32_t>> ranked;
+        while (std::getline(in, line)) {
+            if (line.empty() || line[0] == '#') {
+                continue;
+            }
+            std::istringstream ls(line);
+            int64_t il = -1, e = -1;
+            double u = 0;
+            if (ls >> il >> e >> u && il >= 0 && (size_t) il < layers.size() && e >= 0 && e < n_expert && u > 0) {
+                uses[il * n_expert + e] = u * 0.5; // older runs count half
+                ranked.push_back({ u, (int32_t) (il * n_expert + e) });
+            }
+        }
+        std::sort(ranked.begin(), ranked.end(), [](auto & a, auto & b) { return a.first > b.first; });
+        if ((int64_t) ranked.size() > n_slots) {
+            ranked.resize(n_slots);
+        }
+        // One read per layer, like a layer's own demand.
+        const auto t0 = std::chrono::steady_clock::now();
+        std::vector<std::vector<uint8_t>> want(layers.size(), std::vector<uint8_t>(n_expert, 0));
+        for (auto & r : ranked) {
+            want[r.second / n_expert][r.second % n_expert] = 1;
+        }
+        const uint64_t before = loaded_bytes;
+        for (size_t il = 0; il < layers.size(); il++) {
+            if (std::find(want[il].begin(), want[il].end(), 1) != want[il].end()) {
+                ensure((int) il, want[il], false);
+            }
+        }
+        const double secs = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+        LOG_INF("corsia: expert pool warmed from %s: %lld experts, %.0f MiB in %.1f s\n", profile.c_str(),
+            (long long) loads, (loaded_bytes - before) / 1048576.0, secs);
+        loads = 0;
+        hits = 0;
+        loaded_bytes = 0;
+    }
+
+    // Writes this run's usage merged with the profile it started from.
+    void save_profile() const {
+        if (profile.empty() || uses.empty()) {
+            return;
+        }
+        const size_t slash = profile.find_last_of('/');
+        if (slash != std::string::npos) {
+            const std::string dir = profile.substr(0, slash);
+            for (size_t i = 1; i <= dir.size(); i++) { // mkdir -p without a shell
+                if (i == dir.size() || dir[i] == '/') {
+                    mkdir(dir.substr(0, i).c_str(), 0700);
+                }
+            }
+        }
+        const std::string tmp = profile + ".new";
+        std::ofstream out(tmp);
+        if (!out) {
+            return;
+        }
+        out << "# corsia-pool-profile 1: layer expert uses (older runs count half)\n";
+        for (size_t k = 0; k < uses.size(); k++) {
+            if (uses[k] >= 0.5) {
+                out << k / n_expert << ' ' << k % n_expert << ' ' << uses[k] << '\n';
+            }
+        }
+        out.close();
+        if (out) {
+            std::rename(tmp.c_str(), profile.c_str());
+        }
+    }
+
+    // Room one slice takes in a slot: Corsia needs len + 8192 bytes, page aligned.
+    static uint64_t room(uint64_t stride) {
+        return (stride + 8192 + 4095) / 4096 * 4096;
+    }
+
+    // Called for every expert matmul node: hands its weight tensor's pointer table to ggml once.
+    void register_tensor(const ggml_tensor * w) {
+        if (w == nullptr || w->data == nullptr) {
+            return;
+        }
+        int il = -1;
+        if (std::sscanf(w->name, "blk.%d.", &il) != 1 || il < 0 || (size_t) il >= layers.size()) {
+            return;
+        }
+        for (size_t ti = 0; ti < layers[il].size(); ti++) {
+            if (!registered[il][ti] && layers[il][ti].name == w->name && w->ne[2] == n_expert) {
+                set_ptrs(w->data, ptrs[il][ti].data());
+                registered[il][ti] = 1;
+                registered_n++;
+            }
+        }
+    }
+
+    bool has(int il, int32_t e) const {
+        return (size_t) il < layers.size() && e >= 0 && e < n_expert && where[il * n_expert + e] >= 0;
+    }
+
+    // Makes sure every expert flagged in `want` is in the pool for layer `il`.
+    void ensure(int il, const std::vector<uint8_t> & want, bool count = true) {
+        if ((size_t) il >= layers.size() || layers[il].empty()) {
+            return;
+        }
+        tick++;
+        std::vector<int32_t> missing;
+        for (int64_t e = 0; e < n_expert && e < (int64_t) want.size(); e++) {
+            if (!want[e]) {
+                continue;
+            }
+            if (count) {
+                uses[il * n_expert + e] += 1.0;
+            }
+            const int32_t s = where[il * n_expert + e];
+            if (s >= 0) {
+                last_use[s] = tick;
+                hits++;
+            } else {
+                missing.push_back((int32_t) e);
+            }
+        }
+        if (missing.empty()) {
+            return;
+        }
+        // Slots for the missing experts: free ones first, then the least recently used,
+        // never one this layer is using right now (those were just touched).
+        std::vector<int32_t> slots;
+        for (int32_t s = 0; s < n_slots && slots.size() < missing.size(); s++) {
+            if (owner[s] < 0) {
+                slots.push_back(s);
+            }
+        }
+        while (slots.size() < missing.size()) {
+            int32_t best = -1;
+            for (int32_t s = 0; s < n_slots; s++) {
+                if (last_use[s] != tick && owner[s] >= 0 && (best < 0 || last_use[s] < last_use[best])) {
+                    best = s;
+                }
+            }
+            if (best < 0) {
+                break;
+            }
+            evict(best);
+            last_use[best] = tick; // reserved for this layer
+            slots.push_back(best);
+        }
+        // Experts whose pages a guess already put in the page cache are copied into their
+        // slot from the mapped file (memory speed); the rest are read from the drives.
+        const size_t per = layers[il].size();
+        std::vector<size_t> to_read; // indexes into missing/slots
+        for (size_t i = 0; i < slots.size(); i++) {
+            if (in_page_cache(il, missing[i])) {
+                uint64_t at = (uint64_t) slots[i] * slot_bytes;
+                for (size_t ti = 0; ti < per; ti++) {
+                    const slice & sl = layers[il][ti];
+                    const uint64_t off = sl.offs + (uint64_t) missing[i] * sl.stride;
+                    uint8_t * dst = base + at + off % 4096; // the same alignment a read would give
+                    std::memcpy(dst, map + off, sl.stride);
+                    ptrs[il][ti][missing[i]] = dst;
+                    copied_bytes += sl.stride;
+                    at += room(sl.stride);
+                }
+                take(slots[i], il, missing[i]);
+                copies++;
+            } else {
+                to_read.push_back(i);
+            }
+        }
+        if (to_read.empty()) {
+            return;
+        }
+        std::vector<corsia_range> ranges;
+        std::vector<size_t> tensor_of;
+        for (size_t i : to_read) {
+            uint64_t at = (uint64_t) slots[i] * slot_bytes;
+            for (size_t ti = 0; ti < per; ti++) {
+                const slice & sl = layers[il][ti];
+                ranges.push_back({ sl.offs + (uint64_t) missing[i] * sl.stride, (uint32_t) sl.stride, at });
+                tensor_of.push_back(ti);
+                at += room(sl.stride);
+            }
+        }
+        if (ranges.size() > CORSIA_MAX_RANGES) {
+            failures++;
+            return;
+        }
+        std::vector<corsia_landed> got(ranges.size());
+        if (corsia_read(io, ranges.data(), ranges.size(), got.data()) != 0) {
+            failures++;
+            return; // these experts stay at their usual place in the mapped file
+        }
+        for (size_t j = 0; j < to_read.size(); j++) {
+            const size_t i = to_read[j];
+            bool ok = true;
+            for (size_t r = j * per; r < (j + 1) * per; r++) {
+                ok = ok && got[r].got == ranges[r].len;
+            }
+            if (!ok) {
+                failures++;
+                continue;
+            }
+            for (size_t r = j * per; r < (j + 1) * per; r++) {
+                ptrs[il][tensor_of[r]][missing[i]] = base + got[r].data_off;
+                loaded_bytes += got[r].got;
+            }
+            take(slots[i], il, missing[i]);
+            loads++;
+        }
+    }
+
+    void take(int32_t slot, int il, int32_t e) {
+        owner[slot] = (int32_t) (il * n_expert + e);
+        where[il * n_expert + e] = slot;
+        last_use[slot] = tick;
+    }
+
+    // True when every slice of the expert is in the page cache of the mapped model file.
+    bool in_page_cache(int il, int32_t e) {
+        if (map == nullptr) {
+            return false;
+        }
+        for (const slice & sl : layers[il]) {
+            const uint64_t a = (sl.offs + (uint64_t) e * sl.stride) / 4096 * 4096;
+            const uint64_t b = std::min<uint64_t>(sl.offs + (uint64_t) (e + 1) * sl.stride, map_len);
+            const size_t n = (b - a + 4095) / 4096;
+            core.resize(n);
+            if (b <= a || mincore((void *) (map + a), b - a, core.data()) != 0) {
+                return false;
+            }
+            for (size_t i = 0; i < n; i++) {
+                if (!(core[i] & 1)) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    void evict(int32_t s) {
+        const int32_t key = owner[s];
+        if (key < 0) {
+            return;
+        }
+        const int64_t il = key / n_expert, e = key % n_expert;
+        for (auto & t : ptrs[il]) {
+            t[e] = nullptr; // back to the mapped file until it is loaded again
+        }
+        where[key] = -1;
+        owner[s] = -1;
+    }
+};
