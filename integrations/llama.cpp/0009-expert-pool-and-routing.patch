@@ -23,9 +23,26 @@
 //
 // CORSIA_TRACE=path records which experts every generated token used in every layer, in
 // Corsia's trace format (`corsia replay` reads it). It works without CORSIA_SOCKET too.
+//
+// Residency-aware routing (CORSIA_SWAP=1; on by default with the expert pool, off without
+// it; CORSIA_SWAP=0 turns it off): while generating, a chosen
+// expert that is not in memory yet is swapped for the best runner-up that is, when the
+// runner-up's router score is at least CORSIA_SWAP_RATIO (default 0.5) of the one it
+// replaces and it ranks within CORSIA_SWAP_DEPTH (default 8) places of the top-k. At most
+// CORSIA_SWAP_MAX (default 2) experts per layer change. The swap rewrites the router's
+// choice before llama.cpp gathers the expert weights, so the weights follow the new choice
+// and are normalised as usual. A layer whose missing experts are all swapped never waits
+// for the drives. It changes the output slightly: measure it before trusting it.
+//
+// Confidence-based skipping (CORSIA_SKIP=0.05, off by default): while generating, a chosen
+// expert whose share of the layer's normalised weight is below the threshold is skipped,
+// keeping at least CORSIA_SKIP_MIN (default 4). Its weight becomes 0 and the rest are
+// renormalised, and its slot is pointed at the heaviest chosen expert, so it costs no
+// read. The tail experts move the output least and cost as much to fetch as the head.
 
 #include "../src/corsia-client.h"
 #include "corsia-threads.h"
+#include "corsia-pool.h"
 #include "ggml.h"
 #include "ggml-backend.h"
 #include "gguf.h"
@@ -53,6 +70,7 @@ struct corsia_experts {
         uint64_t offs;   // file offset of expert 0
