             }
-            layers[il].push_back({ data + gguf_get_tensor_offset(g, i), ggml_nbytes(t) / (uint64_t) t->ne[2], t->ne[2] });
+            layers[il].push_back({ data + gguf_get_tensor_offset(g, i), ggml_nbytes(t) / (uint64_t) t->ne[2], t->ne[2], name });
         }
