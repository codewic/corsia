@@ -291,7 +341,162 @@ struct corsia_experts {
         traced++;
     }
 
-    void prefetch(const ggml_tensor * topk, int il) {
+    // True when every slice of expert `e` in layer `il` is in the page cache.
+    bool resident(int il, int64_t e) {
+        if (pool && pool->has(il, (int32_t) e)) {
+            return true; // otherwise: in the page cache counts too, the pool copies it in at memory speed
+        }
+        const uint64_t page = 4096;
+        for (const tensor & t : layers[il]) {
+            const uint64_t a = (t.offs + e * t.stride) / page * page;
+            const uint64_t b = std::min<uint64_t>(t.offs + (e + 1) * t.stride, map_len);
+            if (b <= a) {
+                continue;
+            }
+            const size_t n = (b - a + page - 1) / page;
+            core.resize(n);
+            if (mincore((void *) (map + a), b - a, core.data()) != 0) {
+                return false;
+            }
+            for (size_t i = 0; i < n; i++) {
+                if (!(core[i] & 1)) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    // Keeps the router's probabilities for one generated token, for swap().
+    void keep_probs(const ggml_tensor * probs, int il) {
+        if (probs->type != GGML_TYPE_F32 || probs->ne[1] != 1) {
+            probs_layer = -1;
+            return;
+        }
+        probs_row.resize(probs->ne[0]);
+        ggml_backend_tensor_get(probs, probs_row.data(), 0, probs->ne[0] * sizeof(float));
+        probs_layer = il;
+    }
+
+    // Swaps chosen experts that are not in memory for close runners-up that are, and
+    // writes the new choice back into the router output. Returns true if anything changed.
+    bool swap(int il) {
+        if (probs_layer != il || map == nullptr || (size_t) il >= routers.size() || routers[il].bias != 0) {
+            return false;
+        }
+        const int64_t n_expert = (int64_t) probs_row.size();
+        std::vector<int32_t> missing;
+        for (int32_t e : ids) {
+            if (e >= 0 && e < n_expert && !resident(il, e)) {
+                missing.push_back(e);
+            }
+        }
+        if (missing.empty()) {
+            return false;
+        }
+        miss_layers++;
+        order.resize(n_expert);
+        for (int64_t i = 0; i < n_expert; i++) {
+            order[i] = (int32_t) i;
+        }
+        const size_t depth = std::min<size_t>(ids.size() + swap_depth, n_expert);
+        std::partial_sort(order.begin(), order.begin() + depth, order.end(),
+            [&](int32_t a, int32_t b) { return probs_row[a] > probs_row[b]; });
+        std::vector<int32_t> spare;
+        for (size_t i = 0; i < depth; i++) {
+            const int32_t e = order[i];
+            if (std::find(ids.begin(), ids.end(), e) == ids.end() && resident(il, e)) {
+                spare.push_back(e); // best first
+            }
+        }
+        // Lightest missing experts first: they matter least, so they are the safest to swap.
+        std::sort(missing.begin(), missing.end(), [&](int32_t a, int32_t b) { return probs_row[a] < probs_row[b]; });
+        int changed = 0;
+        size_t next = 0;
+        for (int32_t m : missing) {
+            if (changed >= swap_max || next >= spare.size() || probs_row[spare[next]] < swap_ratio * probs_row[m]) {
+                break;
+            }
+            std::replace(ids.begin(), ids.end(), m, spare[next++]); // skipped slots may repeat it
+            changed++;
+        }
+        if (changed == 0) {
+            return false;
+        }
+        swap_layers++;
+        swap_experts += changed;
+        stalls_avoided += changed == (int) missing.size();
+        return true;
+    }
+
+    // Marks light experts to skip and points their slots at the heaviest one. Returns true
+    // if the choice changed (the caller writes it back).
+    bool skip(int il) {
+        drop_layer = -1;
+        if (probs_layer != il || ids.size() <= (size_t) skip_min) {
+            return false;
+        }
+        double sum = 0;
+        for (int32_t e : ids) {
+            sum += (e >= 0 && e < (int32_t) probs_row.size()) ? probs_row[e] : 0.0f;
+        }
+        if (sum <= 0) {
+            return false;
+        }
+        std::vector<size_t> by(ids.size());
+        for (size_t i = 0; i < by.size(); i++) {
+            by[i] = i;
+        }
+        std::sort(by.begin(), by.end(), [&](size_t a, size_t b) { return probs_row[ids[a]] > probs_row[ids[b]]; });
+        drop.assign(ids.size(), 0);
+        int dropped = 0;
+        for (size_t r = (size_t) skip_min; r < by.size(); r++) {
+            if (probs_row[ids[by[r]]] / sum < skip_below) {
+                drop[by[r]] = 1;
+                dropped++;
+            }
+        }
+        skip_chances += ids.size();
+        if (dropped == 0) {
+            return false;
+        }
+        const int32_t heaviest = ids[by[0]];
+        for (size_t i = 0; i < ids.size(); i++) {
+            if (drop[i]) {
+                ids[i] = heaviest;
+            }
+        }
+        skipped_experts += dropped;
+        drop_layer = il;
+        return true;
+    }
+
+    // Zeroes the skipped slots' weights and renormalises the rest (one generated token).
+    void zero_skipped(ggml_tensor * w, int il) {
+        if (drop_layer != il || w->type != GGML_TYPE_F32 || w->ne[0] != (int64_t) drop.size() || ggml_nelements(w) != w->ne[0]) {
+            return;
+        }
+        std::vector<float> v(drop.size());
+        ggml_backend_tensor_get(w, v.data(), 0, v.size() * sizeof(float));
+        double kept = 0;
+        for (size_t i = 0; i < v.size(); i++) {
+            if (drop[i]) {
+                v[i] = 0.0f;
+            } else {
+                kept += v[i];
+            }
+        }
+        if (kept <= 0) {
+            return;
+        }
+        for (float & x : v) {
+            x = (float) (x / kept);
+        }
+        ggml_backend_tensor_set(w, v.data(), 0, v.size() * sizeof(float));
+        drop_layer = -1;
+    }
+
+    void prefetch(ggml_tensor * topk, int il) {
         if (il < 0 || (size_t) il >= layers.size() || layers[il].empty() || topk->type != GGML_TYPE_I32) {
             return;
         }
@@ -319,6 +524,21 @@ struct corsia_experts {
         if (trace && n_tok == 1) {
             record(il, ids);
         }
+        bool changed = skip_below > 0 && n_tok == 1 && skip(il);
+        changed = (swap_on && n_tok == 1 && swap(il)) || changed;
+        if (changed) {
+            ggml_backend_tensor_set(topk, ids.data(), 0, ids.size() * sizeof(int32_t));
+            want.assign(n_expert, 0);
+            for (int32_t e : ids) {
+                if (e >= 0 && e < n_expert) {
+                    want[e] = 1;
+                }
+            }
+        }
+        if (pool) {
+            pool->ensure(il, want); // read straight into the pool; the matmul is pointed there
+            return;
+        }
         if (broken || client == nullptr) {
             return;
         }
@@ -343,16 +563,40 @@ struct corsia_experts {
         bytes += got;
     }
 
+    // The layer number when `name` is exactly prefix + digits, else -1. ggml also names
+    // views of a tensor after it ("ffn_moe_probs-3 (reshaped)"), which must not match.
+    static int layer_of(const char * name, const char * prefix, size_t n) {
+        if (std::strncmp(name, prefix, n) != 0 || name[n] < '0' || name[n] > '9') {
+            return -1;
+        }
+        const char * p = name + n;
+        while (*p >= '0' && *p <= '9') {
+            p++;
+        }
+        return *p == '\0' ? std::atoi(name + n) : -1;
+    }
+
     static bool eval_cb(struct ggml_tensor * t, bool ask, void * user_data) {
         static const char topk_prefix[] = "ffn_moe_topk-";
         static const char inp_prefix[] = "ffn_inp-";
+        static const char probs_prefix[] = "ffn_moe_probs-";
         auto * self = static_cast<corsia_experts *>(user_data);
         const bool topk = std::strncmp(t->name, topk_prefix, sizeof(topk_prefix) - 1) == 0;
         const bool inp = self->predict_on && std::strncmp(t->name, inp_prefix, sizeof(inp_prefix) - 1) == 0;
+        static const char wnorm_prefix[] = "ffn_moe_weights_norm-";
+        const bool probs = (self->swap_on || self->skip_below > 0) && layer_of(t->name, probs_prefix, sizeof(probs_prefix) - 1) >= 0;
+        const bool wnorm = self->skip_below > 0 && layer_of(t->name, wnorm_prefix, sizeof(wnorm_prefix) - 1) >= 0;
         if (ask) {
-            return topk || inp; // see only the router outputs and the hidden states before them
+            if (self->pool && t->op == GGML_OP_MUL_MAT_ID) {
+                self->pool->register_tensor(t->src[0]); // once per weight tensor
+            }
+            return topk || inp || probs || wnorm; // see only the router outputs and the hidden states before them
         }
-        if (inp) {
+        if (wnorm) {
+            self->zero_skipped(t, std::atoi(t->name + sizeof(wnorm_prefix) - 1));
+        } else if (probs) {
+            self->keep_probs(t, std::atoi(t->name + sizeof(probs_prefix) - 1));
+        } else if (inp) {
             self->predict_next(t, std::atoi(t->name + sizeof(inp_prefix) - 1));
         } else if (topk) {
             self->prefetch(t, std::atoi(t->name + sizeof(topk_prefix) - 1));
@@ -425,8 +669,64 @@ inline void corsia_experts_install(const std::string & model_path, llama_context
         if (with_router == 0 || s->map == nullptr) {
             s->predict_on = false;
         }
+        if (const char * w = std::getenv("CORSIA_SWAP")) {
