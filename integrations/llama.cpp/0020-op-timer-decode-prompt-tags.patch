From e2e46620865bcb647201de53aa51e733a33a35c8 Mon Sep 17 00:00:00 2001
From: codewic <codewic@users.noreply.github.com>
Date: Tue, 24 Nov 2026 16:08:37 +0000
Subject: [PATCH 3/5] corsia: op timer tags decode and prompt nodes

---
 ggml/src/ggml-cpu/ggml-cpu.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 4b80b15..426824a 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -3196,7 +3196,16 @@ static void corsia_prof_add(const struct ggml_tensor * node, double us) {
             if (dot != NULL) w = dot + 1;
         }
     }
-    snprintf(key, sizeof key, "%s %s", ggml_op_desc(node), w);
+    // matmuls and attention are tagged by how many tokens they ran for: "1" (decode) or "n"
+    const char * tag = "";
+    if (node->src[1] != NULL) {
+        int64_t tokens = -1;
+        if (node->op == GGML_OP_MUL_MAT)        tokens = node->src[1]->ne[1];
+        if (node->op == GGML_OP_MUL_MAT_ID)     tokens = node->src[1]->ne[2];
+        if (node->op == GGML_OP_FLASH_ATTN_EXT) tokens = node->src[0]->ne[1];
+        if (tokens >= 0) tag = tokens == 1 ? "1 " : "n ";
+    }
+    snprintf(key, sizeof key, "%s%s %s", tag, ggml_op_desc(node), w);
     char * suffix = strstr(key, ".weight");
     if (suffix != NULL) *suffix = 0;
     for (int i = 0; i < corsia_prof_n; i++) {
-- 
