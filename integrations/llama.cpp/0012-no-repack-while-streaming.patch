From c1b2d50dc0f17592a1d5f085134d139333f2d5bb Mon Sep 17 00:00:00 2001
From: codewic <codewic@users.noreply.github.com>
Date: Mon, 23 Nov 2026 20:49:20 +0000
Subject: [PATCH] corsia: turn weight repacking off while streaming

---
 common/common.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/common/common.cpp b/common/common.cpp
index 7bf96ab..696d0aa 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -1699,6 +1699,13 @@ struct llama_model_params common_model_params_to_llama(common_params & params) {
     mparams.tensor_split    = params.tensor_split;
     mparams.check_tensors   = params.check_tensors;
     mparams.use_extra_bufts = !params.no_extra_bufts;
+    if (mparams.use_extra_bufts && corsia_streaming() && !getenv("CORSIA_REPACK")) {
+        // Repacking copies every weight into a new layout at load: the whole file is read
+        // from the drives and held in memory twice over, which is exactly what streaming
+        // avoids, and the expert pool cannot serve repacked experts. CORSIA_REPACK=1 keeps it.
+        mparams.use_extra_bufts = false;
+        LOG_INF("corsia: weight repacking off while streaming (CORSIA_REPACK=1 keeps it)\n");
+    }
     mparams.no_host         = params.no_host;
 
     if (params.kv_overrides.empty()) {
-- 
