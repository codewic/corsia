+#include "corsia-threads.h"
 
 #include "build-info.h"
 #include "chat.h"
@@ -1257,6 +1258,8 @@ bool common_params_to_map(int argc, char ** argv, llama_example ex, std::map<com
 }
 
 bool common_params_parse(int argc, char ** argv, common_params & params, llama_example ex, void(*print_usage)(int, char **)) {
+    corsia_cool_threads(argv); // streaming through Corsia: waiting threads sleep instead of spinning
+
     auto ctx_arg = common_params_parser_init(params, ex, print_usage);
     const common_params params_org = ctx_arg.params; // the example can modify the default params
 
@@ -1278,6 +1281,11 @@ bool common_params_parse(int argc, char ** argv, common_params & params, llama_e
             exit(0);
         }
         params.lr.init();
+        if (corsia_streaming() && !corsia_has_openmp() &&
+            std::none_of(argv, argv + argc, [](const char * a) { return strcmp(a, "--poll") == 0; })) {
+            params.cpuparams.poll = 0; // llama.cpp's own thread pool: sleep while experts load
+            params.cpuparams_batch.poll = 0;
+        }
     } catch (const std::invalid_argument & ex) {
         fprintf(stderr, "%s\n", ex.what());
         ctx_arg.params = params_org;
