diff --git a/common/corsia-threads.h b/common/corsia-threads.h
new file mode 100644
index 0000000..033c524
--- /dev/null
+++ b/common/corsia-threads.h
@@ -0,0 +1,74 @@
+#pragma once
+
+// Cool waiting while Corsia streams experts.
+//
+// When the model is streamed, compute threads spend much of each token waiting for
+// experts to arrive from the drives. By default the OpenMP runtime keeps a waiting thread
+// spinning at full power for a while before it sleeps, and every wait in a streamed token
+// pays that again: heat and fan noise for no work. With CORSIA_SOCKET set, this makes
+// waiting threads give up the core quickly instead.
+//
+// The OpenMP runtime reads its settings once, before main(), so the setting is made by
+// starting the program again with it in the environment. That happens once, at the very
+// start, before anything is loaded. Builds without OpenMP get polling level 0 instead
+// (the same idea for llama.cpp's own thread pool), unless --poll was given.
+//
+// Your own OMP_WAIT_POLICY or GOMP_SPINCOUNT always wins. CORSIA_COOL=0 turns this off.
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <strings.h>
+
+#if defined(__linux__)
+#include <dlfcn.h>
+#include <unistd.h>
+#endif
+
+// Spins before a waiting thread sleeps. The OpenMP default is 300000.
+#define CORSIA_SPINCOUNT "10000"
+
+// True when the OpenMP runtime is loaded (the CPU backend was built with it).
+static inline bool corsia_has_openmp() {
+#if defined(__linux__)
+    return dlsym(RTLD_DEFAULT, "omp_get_max_threads") != nullptr;
+#else
+    return false;
+#endif
+}
+
+static inline bool corsia_streaming() {
+    const char * sock = getenv("CORSIA_SOCKET");
+    const char * cool = getenv("CORSIA_COOL");
+    return sock && *sock && !(cool && strcmp(cool, "0") == 0);
+}
+
+// Call first thing with main()'s argv. Returns only if the program carries on as it is.
+static inline void corsia_cool_threads(char ** argv) {
+#if defined(__linux__)
+    if (!corsia_has_openmp() || !corsia_streaming() || getenv("CORSIA_COOL") || getenv("OMP_WAIT_POLICY") || getenv("GOMP_SPINCOUNT")) {
+        return;
+    }
+    setenv("GOMP_SPINCOUNT", CORSIA_SPINCOUNT, 1);
+    setenv("CORSIA_COOL", "1", 1); // marks the second start, so this happens once
+    execv("/proc/self/exe", argv);
+    unsetenv("GOMP_SPINCOUNT"); // could not start again: carry on with the defaults
+#else
+    (void) argv;
+#endif
+}
+
+// What waiting threads do, for the startup line.
+static inline const char * corsia_cool_describe() {
+    static char text[64];
+    const char * policy = getenv("OMP_WAIT_POLICY");
+    const char * spin = getenv("GOMP_SPINCOUNT");
+    if (spin && *spin) {
+        snprintf(text, sizeof(text), "%s times", spin);
+    } else if (policy && strcasecmp(policy, "passive") == 0) {
+        return "not at all";
+    } else {
+        return "the OpenMP default (300000 times)";
+    }
+    return text;
+}
