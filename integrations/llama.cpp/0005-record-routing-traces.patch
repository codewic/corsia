+    // Routing trace (CORSIA_TRACE): one line per generated token, one group per layer.
+    FILE * trace = nullptr;
+    std::vector<std::vector<int32_t>> trace_tok;
+    uint64_t traced = 0;
+
     ~corsia_experts() {
+        if (trace) {
+            std::fclose(trace);
+            LOG_INF("corsia: recorded the routing of %llu generated tokens\n", (unsigned long long) traced);
+        }
         if (client) {
             corsia_close(client);
         }
@@ -249,8 +261,28 @@ struct corsia_experts {
     }
 
     // The router output for layer `il`: I32 [n_expert_used, n_tokens], possibly a view.
+    void record(int il, const std::vector<int32_t> & used) {
+        if (trace_tok.size() != layers.size()) {
+            trace_tok.assign(layers.size(), {});
+        }
+        trace_tok[il] = used;
+        if (il + 1 != (int) layers.size()) {
+            return;
+        }
+        for (size_t l = 0; l < trace_tok.size(); l++) {
+            if (l) std::fputc(' ', trace);
+            for (size_t i = 0; i < trace_tok[l].size(); i++) {
+                std::fprintf(trace, i ? ",%d" : "%d", trace_tok[l][i]);
+            }
+            trace_tok[l].clear();
+        }
+        std::fputc('\n', trace);
+        std::fflush(trace);
+        traced++;
+    }
+
