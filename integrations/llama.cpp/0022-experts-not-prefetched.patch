From eff76ccfebfd4d39d5d0694c2be29b041584d4e5 Mon Sep 17 00:00:00 2001
From: codewic <codewic@users.noreply.github.com>
Date: Tue, 24 Nov 2026 18:59:17 +0000
Subject: [PATCH 1/5] corsia: expert tensors are not prefetched when the pool
 streams them

---
 src/llama-model-loader.cpp | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index c9b3c4c..31c5edd 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -1524,8 +1524,30 @@ void llama_model_loader::init_mappings(bool prefetch, llama_mlocks * mlock_mmaps
 
             const size_t prefetch_size = prefetch && use_mmap ? -1 : 0;
 
+            // Corsia: with experts streamed into the pool (CORSIA_SOCKET set), the expert tensors are
+            // read straight into the pool. Mapped as lazy ranges they are not prefetched: without
+            // that, MAP_POPULATE pulled the whole file through Corsia's mount before the pool read
+            // the experts again (18.6 GB of a 36.8 GB cold start on testbox). The other weights are
+            // still prefetched. CORSIA_PREFETCH_ALL=1 keeps the old behaviour.
+            llama_mmap::ranges ranges = lazy.for_file(idx);
+            if (getenv("CORSIA_SOCKET") != nullptr && getenv("CORSIA_PREFETCH_ALL") == nullptr) {
+                size_t n_exps = 0, exps_bytes = 0;
+                for (const auto & it : weights_map) {
+                    const auto & w = it.second;
+                    if (w.idx == idx && it.first.find("_exps") != std::string::npos) {
+                        ranges.emplace_back(w.offs, w.offs + ggml_nbytes(w.tensor));
+                        n_exps++;
+                        exps_bytes += ggml_nbytes(w.tensor);
+                    }
+                }
+                if (n_exps > 0) {
+                    LLAMA_LOG_INFO("%s: corsia: %zu expert tensors (%zu MiB) left to the expert pool, not prefetched\n",
+                        __func__, n_exps, exps_bytes >> 20);
+                }
+            }
+
             std::unique_ptr<llama_mmap> mapping = std::make_unique<llama_mmap>(file.get(), prefetch_size, is_numa,
-                    lazy.for_file(idx));
+                    ranges);
             mmaps_used.emplace_back(mapping->size(), 0);
             if (mlock_mmaps) {
                 std::unique_ptr<llama_mlock> mlock_mmap(new llama_mlock());
-- 
