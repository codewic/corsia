-    // Makes sure every expert flagged in `want` is in the pool for layer `il`.
-    void ensure(int il, const std::vector<uint8_t> & want, bool count = true) {
-        if ((size_t) il >= layers.size() || layers[il].empty()) {
-            return;
-        }
-        tick++;
-        std::vector<int32_t> missing;
-        for (int64_t e = 0; e < n_expert && e < (int64_t) want.size(); e++) {
-            if (!want[e]) {
