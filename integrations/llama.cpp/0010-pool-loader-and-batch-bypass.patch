         std::vector<int32_t> slots;
-        for (int32_t s = 0; s < n_slots && slots.size() < missing.size(); s++) {
-            if (owner[s] < 0) {
+        for (int32_t s = 0; s < n_slots && slots.size() < n; s++) {
