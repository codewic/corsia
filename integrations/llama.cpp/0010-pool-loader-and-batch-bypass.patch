-            return; // these experts stay at their usual place in the mapped file
+        if (corsia_read(c, ranges.data(), ranges.size(), got.data()) != 0) {
+            return;
         }
         for (size_t j = 0; j < to_read.size(); j++) {
-            const size_t i = to_read[j];
             bool ok = true;
             for (size_t r = j * per; r < (j + 1) * per; r++) {
                 ok = ok && got[r].got == ranges[r].len;
             }
             if (!ok) {
