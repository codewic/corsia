+
+    // Publishes filled slots (lock held): pointers for ggml, or the slot freed on failure.
+    // Returns how many experts landed.
+    size_t publish(int il, const std::vector<int32_t> & exps, const std::vector<int32_t> & slots,
+                   const std::vector<std::vector<const void *>> & got_ptrs) {
+        size_t ok_n = 0;
+        for (size_t i = 0; i < exps.size(); i++) {
+            const int32_t key = (int32_t) (il * n_expert + exps[i]);
+            const bool ok = std::all_of(got_ptrs[i].begin(), got_ptrs[i].end(), [](const void * p) { return p != nullptr; });
+            if (ok) {
+                for (size_t ti = 0; ti < got_ptrs[i].size(); ti++) {
+                    ptrs[il][ti][exps[i]] = got_ptrs[i][ti];
+                }
+                ok_n++;
+            } else {
+                owner[slots[i]] = -1;
+                where[key] = -1;
                 failures++;
+            }
+            loading[slots[i]] = 0;
+        }
+        cv.notify_all();
+        return ok_n;
+    }
+
+    // Reserves slots for exps (lock held), marking them as being filled.
+    std::vector<int32_t> reserve(int il, std::vector<int32_t> & exps) {
+        std::vector<int32_t> slots = pick_slots(exps.size());
+        exps.resize(slots.size());
+        for (size_t i = 0; i < slots.size(); i++) {
+            owner[slots[i]] = (int32_t) (il * n_expert + exps[i]);
+            where[il * n_expert + exps[i]] = slots[i];
+            loading[slots[i]] = 1;
+            last_use[slots[i]] = tick;
+        }
+        return slots;
+    }
+
+    // Makes sure every expert flagged in `want` is in the pool for layer `il`. A layer that
+    // misses more than max_load experts (a large prompt batch touches nearly all of them,
+    // more than the pool holds) loads nothing: the missing experts are returned for the
+    // caller to fetch the way it does without the pool, and the pool keeps the experts
+    // generation needs instead of churning through the whole model.
+    std::vector<int32_t> ensure(int il, const std::vector<uint8_t> & want, bool count = true, size_t max_load = SIZE_MAX) {
+        if ((size_t) il >= layers.size() || layers[il].empty()) {
+            return {};
+        }
+        std::unique_lock<std::mutex> lk(mu);
+        tick++;
+        std::vector<int32_t> missing;
+        for (int64_t e = 0; e < n_expert && e < (int64_t) want.size(); e++) {
+            if (!want[e]) {
                 continue;
             }
-            for (size_t r = j * per; r < (j + 1) * per; r++) {
-                ptrs[il][tensor_of[r]][missing[i]] = base + got[r].data_off;
-                loaded_bytes += got[r].got;
+            if (count) {
+                uses[il * n_expert + e] += 1.0;
+            }
+            const int32_t key = (int32_t) (il * n_expert + e);
+            if (where[key] >= 0 && loading[where[key]]) {
+                waits++; // the background loader is filling it: wait instead of reading it twice
+                cv.wait(lk, [&] { return where[key] < 0 || !loading[where[key]]; });
+            }
+            const int32_t s = where[key];
+            if (s >= 0) {
+                last_use[s] = tick;
+                hits++;
+            } else {
+                missing.push_back((int32_t) e);
             }
-            take(slots[i], il, missing[i]);
-            loads++;
         }
+        if (missing.empty()) {
+            return {};
+        }
+        if (missing.size() > max_load) {
+            bypassed += missing.size();
+            return missing;
+        }
+        std::vector<int32_t> slots = reserve(il, missing);
+        if (slots.empty()) {
+            return missing;
+        }
+        lk.unlock();
+        std::vector<std::vector<const void *>> got_ptrs;
+        uint64_t rb = 0, cb = 0, cn = 0;
+        fill(io, il, missing, slots, got_ptrs, rb, cb, cn);
+        lk.lock();
+        const size_t ok_n = publish(il, missing, slots, got_ptrs);
+        loads += ok_n - std::min<uint64_t>(ok_n, cn);
+        copies += cn;
+        loaded_bytes += rb;
+        copied_bytes += cb;
+        return {};
     }
 
-    void take(int32_t slot, int il, int32_t e) {
-        owner[slot] = (int32_t) (il * n_expert + e);
-        where[il * n_expert + e] = slot;
-        last_use[slot] = tick;
+    // A guess for layer il: the background loader fills the experts the pool lacks.
+    void guess(int il, const std::vector<int32_t> & experts) {
+        if (bg == nullptr || (size_t) il >= layers.size()) {
+            return;
+        }
+        std::lock_guard<std::mutex> lk(mu);
+        jobs.push_back({ il, experts });
+        while (jobs.size() > 2) {
+            jobs.pop_front();
+            stale++;
+        }
+        cv.notify_all();
+    }
+
+    void run_loader() {
+        std::unique_lock<std::mutex> lk(mu);
+        while (true) {
+            cv.wait(lk, [&] { return stop || !jobs.empty(); });
+            if (stop) {
+                return;
+            }
+            job j = std::move(jobs.back()); // only the newest guess is still useful
+            stale += jobs.size() - 1;
+            jobs.clear();
+            std::vector<int32_t> need;
+            for (int32_t e : j.experts) {
+                if (e >= 0 && e < n_expert && where[j.il * n_expert + e] < 0) {
+                    need.push_back(e);
+                }
+            }
+            if (need.empty()) {
+                continue;
+            }
+            std::vector<int32_t> slots = reserve(j.il, need);
+            if (slots.empty()) {
+                continue;
+            }
+            lk.unlock();
+            std::vector<std::vector<const void *>> got_ptrs;
+            uint64_t rb = 0, cb = 0, cn = 0;
+            fill(bg, j.il, need, slots, got_ptrs, rb, cb, cn);
+            lk.lock();
+            bg_loads += publish(j.il, need, slots, got_ptrs);
+            bg_bytes += rb + cb;
+        }
     }
 
     // True when every slice of the expert is in the page cache of the mapped model file.
-    bool in_page_cache(int il, int32_t e) {
+    bool in_page_cache(int il, int32_t e, std::vector<unsigned char> & mc) const {
         if (map == nullptr) {
             return false;
         }
@@ -365,12 +525,12 @@ struct corsia_pool {
             const uint64_t a = (sl.offs + (uint64_t) e * sl.stride) / 4096 * 4096;
             const uint64_t b = std::min<uint64_t>(sl.offs + (uint64_t) (e + 1) * sl.stride, map_len);
             const size_t n = (b - a + 4095) / 4096;
-            core.resize(n);
-            if (b <= a || mincore((void *) (map + a), b - a, core.data()) != 0) {
+            mc.resize(n);
+            if (b <= a || mincore((void *) (map + a), b - a, mc.data()) != 0) {
                 return false;
             }
             for (size_t i = 0; i < n; i++) {
-                if (!(core[i] & 1)) {
+                if (!(mc[i] & 1)) {
                     return false;
                 }
             }
