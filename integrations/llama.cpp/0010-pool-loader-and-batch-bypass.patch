From cf6944b01ead8307d6924e7fc4b93a7a28f544de Mon Sep 17 00:00:00 2001
From: codewic <codewic@users.noreply.github.com>
Date: Mon, 23 Nov 2026 19:04:45 +0000
Subject: [PATCH] Pool: opt-in background loader, prompt batches fetched
 outside the pool

---
 common/corsia-experts.h |  28 +++-
 common/corsia-pool.h    | 290 +++++++++++++++++++++++++++++++---------
 src/corsia-client.h     |  36 +++--
 3 files changed, 276 insertions(+), 78 deletions(-)

diff --git a/common/corsia-experts.h b/common/corsia-experts.h
index 771788a..12c533b 100644
--- a/common/corsia-experts.h
+++ b/common/corsia-experts.h
@@ -104,6 +104,8 @@ struct corsia_experts {
 
     // The expert pool (CORSIA_POOL_MIB): experts in engine-owned memory instead of the page cache.
     std::unique_ptr<corsia_pool> pool;
+    size_t pool_batch_max = 32;     // CORSIA_POOL_BATCH_MAX: more missing experts than this in one layer bypass the pool
+    int64_t pool_batch_tokens = 64; // CORSIA_POOL_BATCH_TOKENS: ...but only in batches of more tokens than this
 
     // Residency-aware routing (CORSIA_SWAP).
     bool swap_on = false;
@@ -295,6 +297,10 @@ struct corsia_experts {
         std::partial_sort(order.begin(), order.begin() + k, order.end(),
             [&](int32_t a, int32_t b) { return logits[a] > logits[b]; });
         guessed[t].assign(order.begin(), order.begin() + k);
+        if (pool) {
+            pool->guess(t, guessed[t]); // the loader fills what the pool lacks, straight into it
+            return;
+        }
         ranges.clear();
         for (const tensor & tn : layers[t]) {
             for (int32_t e : guessed[t]) {
@@ -536,8 +542,18 @@ struct corsia_experts {
             }
         }
         if (pool) {
-            pool->ensure(il, want); // read straight into the pool; the matmul is pointed there
-            return;
+            // Read straight into the pool; the matmul is pointed there. A large prompt batch
+            // gets back the experts it misses and fetches them through the page cache below.
+            // Only prompt-sized batches bypass: a speculative verification batch (a few
+            // drafted tokens) loads into the pool like a single token does.
+            const std::vector<int32_t> rest = pool->ensure(il, want, true, n_tok > pool_batch_tokens ? pool_batch_max : SIZE_MAX);
+            if (rest.empty()) {
+                return;
+            }
+            want.assign(n_expert, 0);
+            for (int32_t e : rest) {
+                want[e] = 1;
+            }
         }
         if (broken || client == nullptr) {
             return;
@@ -681,6 +697,12 @@ inline void corsia_experts_install(const std::string & model_path, llama_context
         if (const char * w = std::getenv("CORSIA_SWAP_DEPTH")) {
             s->swap_depth = std::max(0, std::atoi(w));
         }
+        if (const char * w = std::getenv("CORSIA_POOL_BATCH_MAX")) {
+            s->pool_batch_max = (size_t) std::max(0, std::atoi(w));
+        }
+        if (const char * w = std::getenv("CORSIA_POOL_BATCH_TOKENS")) {
+            s->pool_batch_tokens = std::max(0, std::atoi(w));
+        }
         if (const char * w = std::getenv("CORSIA_SKIP")) {
             s->skip_below = std::max(0.0f, (float) std::atof(w));
         }
@@ -717,7 +739,7 @@ inline void corsia_experts_install(const std::string & model_path, llama_context
                 // already in the pool, guesses cost more drive time than the misses they hide
                 // (measured: 1.46 tok/s with guessing against 1.93 without, same conditions).
                 // Experts a guess or anything else left in the page cache are still copied in.
-                s->predict_on = false;
+                s->predict_on = s->pool->bg != nullptr && s->predict_on; // only with the background loader
                 if (std::getenv("CORSIA_SWAP") == nullptr) {
                     s->swap_on = true; // with the pool on, swapping is the default (CORSIA_SWAP=0 turns it off)
                 }
