+
+    // Fills reserved slots with experts of layer il (lock not held): from the page cache
+    // when a guess already put the pages there, else read by Corsia through client c.
+    // got_ptrs[i][t] receives where tensor t's slice of expert i landed (null on failure).
+    void fill(corsia_client * c, int il, const std::vector<int32_t> & exps, const std::vector<int32_t> & slots,
+              std::vector<std::vector<const void *>> & got_ptrs, uint64_t & read_bytes, uint64_t & copy_bytes, uint64_t & copied) {
         const size_t per = layers[il].size();
-        std::vector<size_t> to_read; // indexes into missing/slots
-        for (size_t i = 0; i < slots.size(); i++) {
-            if (in_page_cache(il, missing[i])) {
+        got_ptrs.assign(exps.size(), std::vector<const void *>(per, nullptr));
+        std::vector<size_t> to_read;
+        std::vector<unsigned char> mc;
+        for (size_t i = 0; i < exps.size(); i++) {
+            if (in_page_cache(il, exps[i], mc)) {
                 uint64_t at = (uint64_t) slots[i] * slot_bytes;
                 for (size_t ti = 0; ti < per; ti++) {
                     const slice & sl = layers[il][ti];
-                    const uint64_t off = sl.offs + (uint64_t) missing[i] * sl.stride;
+                    const uint64_t off = sl.offs + (uint64_t) exps[i] * sl.stride;
                     uint8_t * dst = base + at + off % 4096; // the same alignment a read would give
                     std::memcpy(dst, map + off, sl.stride);
-                    ptrs[il][ti][missing[i]] = dst;
-                    copied_bytes += sl.stride;
+                    got_ptrs[i][ti] = dst;
+                    copy_bytes += sl.stride;
                     at += room(sl.stride);
                 }
-                take(slots[i], il, missing[i]);
-                copies++;
+                copied++;
             } else {
                 to_read.push_back(i);
             }
@@ -312,52 +346,178 @@ struct corsia_pool {
             return;
         }
         std::vector<corsia_range> ranges;
-        std::vector<size_t> tensor_of;
         for (size_t i : to_read) {
             uint64_t at = (uint64_t) slots[i] * slot_bytes;
             for (size_t ti = 0; ti < per; ti++) {
                 const slice & sl = layers[il][ti];
-                ranges.push_back({ sl.offs + (uint64_t) missing[i] * sl.stride, (uint32_t) sl.stride, at });
-                tensor_of.push_back(ti);
+                ranges.push_back({ sl.offs + (uint64_t) exps[i] * sl.stride, (uint32_t) sl.stride, at });
                 at += room(sl.stride);
             }
         }
         if (ranges.size() > CORSIA_MAX_RANGES) {
-            failures++;
             return;
         }
         std::vector<corsia_landed> got(ranges.size());
-        if (corsia_read(io, ranges.data(), ranges.size(), got.data()) != 0) {
